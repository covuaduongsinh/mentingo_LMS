# ================================================================
#  .env.staging.ui  —  build-arg VITE_* cho container web (Remix SPA)
#  Copy thành  deploy/staging/.env.staging.ui  rồi điền giá trị.
#  ĐÂY LÀ BIẾN BUILD-TIME: đổi giá trị => phải BUILD LẠI image web (không sửa runtime được).
#  deploy.sh sẽ source file này và export trước khi build để compose interpolate ${...}.
# ================================================================

# QUAN TRỌNG: generated API client đã tự nhúng tiền tố "/api" trong mọi path (swagger schema
# của repo này dùng global prefix). Vì vậy VITE_API_URL PHẢI là ORIGIN, KHÔNG kèm "/api"
# (nếu kèm sẽ thành /api/api/... -> 404). Đây là điểm khác docs/deployment.md gốc.
VITE_API_URL="https://staging.covuahocduong.com"
VITE_APP_URL="https://staging.covuahocduong.com"

# ---- Optional ----
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_MICROSOFT_OAUTH_ENABLED=false
VITE_SLACK_OAUTH_ENABLED=false

# ================================================================
#  .env.staging.api  —  ENV cho container API (NestJS) ở staging
#  Copy file này thành  deploy/staging/.env.staging.api  rồi điền giá trị thật.
#  KHÔNG commit file .env.staging.api (chỉ commit file .example này).
# ================================================================

# ---- General ----------------------------------------------------
NODE_ENV=production
# CORS_ORIGIN PHẢI trùng đúng origin thật của staging.
# QUAN TRỌNG: seed dùng CORS_ORIGIN để tạo tenant (host = origin) khi KHÔNG set DEV_TENANT_ORIGINS,
# nên chỉ cần đặt đúng đây là login-theo-origin sẽ khớp. Đừng set DEV_TENANT_ORIGINS ở staging.
CORS_ORIGIN="https://staging.covuahocduong.com"
# Mật khẩu mặc định cho các tài khoản seed (seed-staging đặt password = "password" bất kể biến này,
# nhưng một số seed-prod dùng biến PASSWORD — giữ để an toàn).
PASSWORD="password"
DEBUG=false

# ---- Database (Postgres trong compose) --------------------------
# Chỉ cần 1 DATABASE_URL: database.ts fallback urlApp/urlAdmin về nó khi thiếu LMS_/MIGRATOR_ URL.
# host "db" = tên service Postgres trong docker-compose.staging.yml.
DATABASE_URL="postgres://postgres:guidebook@db:5432/guidebook"
# (Tùy chọn) Bật RLS thật: đặt SEED_MANAGE_DB_ROLE=true + 2 URL dưới (xem README mục "RLS đầy đủ").
# SEED_MANAGE_DB_ROLE=true
# MIGRATOR_DATABASE_URL="postgres://postgres:guidebook@db:5432/guidebook"
# LMS_DATABASE_URL="postgres://lms_app_user:replace_with_strong_password@db:5432/guidebook"

# ---- Redis (trong compose) --------------------------------------
REDIS_URL="redis://redis:6379"

# ---- Bảo mật (BẮT BUỘC) -----------------------------------------
# MASTER_KEY: thiếu là app KHÔNG chạy. Sinh bằng:  openssl rand -base64 32
MASTER_KEY=""
JWT_SECRET=""            # openssl rand -base64 32
JWT_REFRESH_SECRET=""    # openssl rand -base64 32  (khác JWT_SECRET)
JWT_EXPIRATION_TIME="15m"

# ---- Email ------------------------------------------------------
# Staging mặc định dùng mailhog (bắt email nội bộ, có container trong compose). LƯU Ý: adapter "smtp"
# sẽ THROW "Missing SMTP configuration" nếu SMTP_HOST trống -> app crash boot. Muốn gửi email thật:
# đổi EMAIL_ADAPTER="smtp" và điền SMTP_HOST/PORT/USER/PASSWORD (hoặc "ses" + AWS_*).
EMAIL_ADAPTER="mailhog"
SMTP_HOST="mailhog"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_EMAIL_FROM="noreply@covuahocduong.com"

# ---- Object storage (MinIO trong compose) -----------------------
# host "minio" = tên service MinIO. forcePathStyle=true nên endpoint dạng http://minio:9000 là hợp lệ.
# Lưu ý: presigned URL sẽ ký theo endpoint này (nội bộ) => browser không tải trực tiếp được.
# Xem README mục "File / MinIO" nếu cần expose công khai.
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="mentingo-staging"

# ---- Chess engine ----------------------------------------------
# Image API không cài Arasan => dùng engine builtin (MIT, yếu hơn, đủ demo).
CHESS_ENGINE_BUILTIN_ONLY=true
# ARASAN_PATH=

# ================================================================
#  OPTIONAL — để trống/disable ở staging nếu chưa test tính năng đó
# ================================================================
# Stripe (thanh toán)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Bunny Stream (video)
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_SIGNING_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_URL=
BUNNY_STREAM_TOKEN_SIGNING_KEY=
# LiveKit (live training)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# AI / observability
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# OAuth (mặc định tắt)
GOOGLE_OAUTH_ENABLED=false
MICROSOFT_OAUTH_ENABLED=false
SLACK_OAUTH_ENABLED=false
